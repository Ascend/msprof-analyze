{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Release Mode",
      "type": "shell",
      "command": "python3 build.py local",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Run Unit Tests",
      "type": "shell",
      "command": "python3 build.py test local",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: All Workspace",
      "type": "shell",
      "command": "rm -rf build dist artifacts *.egg-info __pycache__ .pytest_cache .mypy_cache",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}